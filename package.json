{
  "name": "@axo/pet-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AXO Pet Hatchery, soulbound NFT, Level-10 gear, and Arena monorepo",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "diff": "9.0.0",
    "serialize-javascript": "7.1.0",
    "adm-zip": "0.6.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "test:dev": "node --test tests/dev-server.test.mjs",
    "test:schemas": "npm --workspace @axo/pet-schemas test",
    "test:style": "node --test packages/visual-engine/test/*.test.mjs",
    "test:wardrobe": "node --test tests/wardrobe-*.test.mjs",
    "test:pet-api": "node --test tests/pet-api.test.mjs",
    "test:passport": "node --test tests/passport.test.mjs",
    "dev:pet-api": "node apps/pet-api/src/start.mjs",
    "inspect:live": "node scripts/inspect-live.mjs",
    "verify": "node scripts/verify-repository.mjs",
    "test": "node --test tests/repository.test.mjs",
    "test:contracts": "npm --prefix packages/pet-contracts run test:contracts",
    "test:arena": "npm --prefix apps/arena-web run test:standalone && node --test packages/arena-engine/test/*.test.mjs",
    "check": "npm run verify && npm test && npm run test:schemas && npm run test:wardrobe && npm run test:pet-api && npm run test:passport && npm run test:style && npm run test:contracts && npm run test:arena && npm run test:dev"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
