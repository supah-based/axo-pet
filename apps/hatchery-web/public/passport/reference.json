{
  "schemaVersion": "AXO_PASSPORT_REFERENCE_V1",
  "visualRevision": "5.1.1",
  "lineages": [
    {
      "key": "emerald_sprout",
      "label": "Emerald Protocol Builder",
      "role": "protocol builder and smart-contract workshop engineer",
      "accents": "Robinhood lime, emerald crystal light, cyan circuit traces",
      "motifs": "verified bytecode, modular protocol geometry, crystal wrenches, test receipts",
      "lore": "Emerald Sprouts believe every moonshot should begin with readable code and a test. They turn degen curiosity into protocols the crew can inspect, simulate, and improve.",
      "accent": "#54F6A7",
      "temperament": "constructive, curious, inventive"
    },
    {
      "key": "sapphire_tide",
      "label": "Sapphire Chain Courier",
      "role": "onchain route courier and packet runner",
      "accents": "sky blue, electric cyan, Robinhood lime highlights",
      "motifs": "route arrows, packet stripes, destination nodes, gas-aware courier seams",
      "lore": "Sapphire Tides carry signals across pools and chains without losing the receipt. Their speed comes from route discipline, gas awareness, and checking the destination twice.",
      "accent": "#58C9FF",
      "temperament": "precise, observant, fast"
    },
    {
      "key": "amethyst_dream",
      "label": "Amethyst Ghost Crew",
      "role": "ghost-transaction analyst and wallet-trail investigator",
      "accents": "void violet, old pink, magenta, cyan ghost light",
      "motifs": "mempool echoes, spectral ledgers, wallet trails, broken-block constellations",
      "lore": "Amethyst Dreams listen where the public timeline goes quiet: wallet trails, pending transactions, and half-formed narratives. They turn ghost signals into evidence without mistaking whispers for proof.",
      "accent": "#C78CFF",
      "temperament": "quiet, intuitive, analytical"
    },
    {
      "key": "solar_peach",
      "label": "Solar Momentum Racer",
      "role": "candle runner and momentum field pilot",
      "accents": "warm gold, coral, Robinhood lime, old-pink sparks",
      "motifs": "speed chevrons, volume bars, green-candle trails, risk-band racing seams",
      "lore": "Solar Peaches live for candles, volume, and clean momentum, but their racers know that speed without a stop is just exit liquidity wearing goggles.",
      "accent": "#FFAD4D",
      "temperament": "bold, cheerful, kinetic"
    },
    {
      "key": "rose_bloom",
      "label": "Rose Signal Riot",
      "role": "community signal operator and meme-lab broadcaster",
      "accents": "old pink, magenta, sky blue, Robinhood lime tags",
      "motifs": "original sticker language, signal waves, halftone bursts, crew beacon patches",
      "lore": "Rose Blooms turn memes, raids, and referrals into durable crew energy. Their signal travels through people, so attribution and anti-spam discipline matter as much as reach.",
      "accent": "#FF708F",
      "temperament": "social, playful, loyal"
    },
    {
      "key": "midnight_mint",
      "label": "Midnight White-Hat Unit",
      "role": "white-hat security analyst and permission guardian",
      "accents": "mint, cyan, white highlights, Robinhood lime checks",
      "motifs": "security hexes, permission graphs, firewall seams, safe-passage shields",
      "lore": "Midnight Mints guard the Hatchery from counterfeit contracts, poisoned approvals, and too-good-to-be-true links. White-hat curiosity is their favorite armor.",
      "accent": "#64F3D3",
      "temperament": "protective, clever, careful"
    }
  ],
